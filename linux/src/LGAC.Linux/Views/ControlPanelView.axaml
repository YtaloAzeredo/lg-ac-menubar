<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LGAC.Linux.Views.ControlPanelView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SegmentBackground" Color="#EDEDED" />
                    <SolidColorBrush x:Key="SegmentHoverBackground" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="SegmentBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="SegmentForeground" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="SelectedBackground" Color="#005FB8" />
                    <SolidColorBrush x:Key="SelectedHoverBackground" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="SelectedForeground" Color="#FFFFFF" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="SelectedBackground" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="SelectedBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="SelectedForeground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="SelectedForeground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="SelectedForeground" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SegmentBackground" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="SegmentHoverBackground" Color="#464646" />
                    <SolidColorBrush x:Key="SegmentBorderBrush" Color="#505050" />
                    <SolidColorBrush x:Key="SegmentForeground" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="SelectedBackground" Color="#60CDFF" />
                    <SolidColorBrush x:Key="SelectedHoverBackground" Color="#78D5FF" />
                    <SolidColorBrush x:Key="SelectedForeground" Color="#0B0B0B" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="SelectedBackground" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="SelectedBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="SelectedHoverBackground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="SelectedForeground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="SelectedForeground" />
                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="SelectedForeground" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <StreamGeometry x:Key="Glyph.Warning">F0 M12 3L22.5 21L1.5 21Z M11 9.5L13 9.5L13 15L11 15Z M11 16.5L13 16.5L13 18.5L11 18.5Z</StreamGeometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.circle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.circle PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Button.power">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Button.power PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.power:not(.on)">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBackground}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedBackground}" />
        </Style>
        <Style Selector="Button.power:not(.on):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedHoverBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedHoverBackground}" />
        </Style>
        <Style Selector="Button.power:not(.on):pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedHoverBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedHoverBackground}" />
        </Style>
        <Style Selector="Button.power.on">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
        </Style>
        <Style Selector="Button.power.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedHoverBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForeground}" />
        </Style>
        <Style Selector="Button.power.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedHoverBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SelectedForeground}" />
        </Style>

        <Style Selector="RadioButton.segment">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SegmentForeground}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="SegmentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SegmentBackground}"
                            BorderBrush="{DynamicResource SegmentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter Name="SegmentContent"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover /template/ Border#SegmentBorder">
            <Setter Property="Background" Value="{DynamicResource SegmentHoverBackground}" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#SegmentBorder">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBackground}" />
        </Style>
        <Style Selector="RadioButton.segment:checked:pointerover /template/ Border#SegmentBorder">
            <Setter Property="Background" Value="{DynamicResource SelectedHoverBackground}" />
        </Style>
        <Style Selector="RadioButton.segment:focus-visible /template/ Border#SegmentBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource SegmentForeground}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="RadioButton.segment PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <Style Selector="Grid.row">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Grid.row PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="14">
        <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="SwitchDeviceButton"
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Classes="circle"
                    AutomationProperties.Name="Trocar aparelho"
                    Click="OnSwitchDeviceClick"
                    ToolTip.Tip="Trocar aparelho">
                <PathIcon Data="{StaticResource Icon.Back}" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="AliasText" Classes="headline" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AmbientText" Margin="0,2,0,0" Classes="secondary" />
            </StackPanel>
            <Button x:Name="PowerButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Classes="circle power"
                    Click="OnPowerClick">
                <PathIcon Data="{StaticResource Icon.Power}" />
            </Button>
        </Grid>

        <Border Margin="0,0,0,10" Classes="divider" />

        <StackPanel x:Name="Body">
            <Grid x:Name="TemperatureRow" Margin="0,0,0,10" HorizontalAlignment="Center" ColumnDefinitions="Auto,Auto,Auto">
                <Button x:Name="MinusButton"
                        VerticalAlignment="Center"
                        Classes="circle"
                        AutomationProperties.Name="Diminuir temperatura"
                        Click="OnMinusClick">
                    <PathIcon Data="{StaticResource Icon.Minus}" />
                </Button>
                <TextBlock x:Name="TargetTempText"
                           Grid.Column="1"
                           MinWidth="96"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           FontSize="30"
                           FontWeight="Light"
                           TextAlignment="Center" />
                <Button x:Name="PlusButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Classes="circle"
                        AutomationProperties.Name="Aumentar temperatura"
                        Click="OnPlusClick">
                    <PathIcon Data="{StaticResource Icon.Plus}" />
                </Button>
            </Grid>

            <StackPanel x:Name="ModeSection" Margin="0,0,0,10">
                <TextBlock Margin="0,0,0,4" Classes="secondary" Text="Modo" />
                <UniformGrid x:Name="ModeGrid" Margin="-2,0" />
            </StackPanel>

            <StackPanel x:Name="WindSection" Margin="0,0,0,10">
                <TextBlock Margin="0,0,0,4" Classes="secondary" Text="Ventilador" />
                <UniformGrid x:Name="WindGrid" Margin="-2,0" />
            </StackPanel>

            <StackPanel x:Name="Switches">
                <Grid x:Name="SwingUpDownRow" Classes="row" ColumnDefinitions="26,*,Auto">
                    <PathIcon Data="{StaticResource Icon.SwingVertical}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Swing vertical" />
                    <ToggleSwitch x:Name="SwingUpDownToggle"
                                  Grid.Column="2"
                                  Margin="0,-3,-12,-3"
                                  AutomationProperties.Name="Swing vertical"
                                  IsCheckedChanged="OnSwingUpDownChanged"
                                  OffContent="{x:Null}"
                                  OnContent="{x:Null}" />
                </Grid>
                <Grid x:Name="SwingLeftRightRow" Classes="row" ColumnDefinitions="26,*,Auto">
                    <PathIcon Data="{StaticResource Icon.SwingHorizontal}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Swing horizontal" />
                    <ToggleSwitch x:Name="SwingLeftRightToggle"
                                  Grid.Column="2"
                                  Margin="0,-3,-12,-3"
                                  AutomationProperties.Name="Swing horizontal"
                                  IsCheckedChanged="OnSwingLeftRightChanged"
                                  OffContent="{x:Null}"
                                  OnContent="{x:Null}" />
                </Grid>
                <Grid x:Name="DisplayLightRow" Classes="row" ColumnDefinitions="26,*,Auto">
                    <PathIcon Data="{StaticResource Icon.Light}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Luz do visor" />
                    <ToggleSwitch x:Name="DisplayLightToggle"
                                  Grid.Column="2"
                                  Margin="0,-3,-12,-3"
                                  AutomationProperties.Name="Luz do visor"
                                  IsCheckedChanged="OnDisplayLightChanged"
                                  OffContent="{x:Null}"
                                  OnContent="{x:Null}" />
                </Grid>
                <Grid x:Name="TimerRow" Classes="row" Margin="0,4,0,0" ColumnDefinitions="26,*,Auto">
                    <PathIcon Data="{StaticResource Icon.Timer}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Desligar em" />
                    <Button x:Name="TimerButton"
                            Grid.Column="2"
                            Padding="10,4"
                            Click="OnTimerClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TimerText" VerticalAlignment="Center" />
                            <Path VerticalAlignment="Center"
                                  Data="M1 1L5 5L9 1"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  StrokeThickness="1.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Border Margin="0,10,0,10" Classes="divider" />

        <Grid ColumnDefinitions="*,Auto,Auto">
            <Grid VerticalAlignment="Center">
                <Grid x:Name="StatusPanel" ColumnDefinitions="Auto,*" IsVisible="False">
                    <PathIcon Width="14"
                              Height="14"
                              Margin="0,1,6,0"
                              VerticalAlignment="Top"
                              Data="{StaticResource Glyph.Warning}"
                              Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               MaxHeight="32"
                               Classes="warning"
                               LineHeight="16"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </Grid>
                <TextBlock x:Name="UpdatedText"
                           Classes="secondary"
                           IsVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Classes="icon"
                    AutomationProperties.Name="Atualizar agora"
                    Click="OnRefreshClick"
                    ToolTip.Tip="Atualizar agora">
                <PathIcon Data="{StaticResource Icon.Refresh}" />
            </Button>
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Classes="icon"
                    AutomationProperties.Name="Configurações"
                    Click="OnSettingsClick">
                <PathIcon Data="{StaticResource Icon.Settings}" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
