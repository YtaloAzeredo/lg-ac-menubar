<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#B04F00" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="LinkBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#474747" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8B8B8" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFA338" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="LinkBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3D3D3D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="TextBlock.headline">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="TextBlock.warning">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>

    <Style Selector="Button.list">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ButtonBackground" Color="#E6E6E6" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DCDCDC" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D6D6D6" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ButtonBackground" Color="#3D3D3D" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#474747" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#474747" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Path.spinner">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Data" Value="M 10,2 A 8,8 0 1 1 2,10" />
        <Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>

    <Style Selector="Path.spinner.spinning">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
