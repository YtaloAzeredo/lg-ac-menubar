<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>lg-ac</AssemblyName>
    <RootNamespace>LGAC.Linux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>LG AC</Product>
    <AssemblyTitle>LG AC</AssemblyTitle>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Tmds.DBus.Protocol" />
    <TrimmerRootAssembly Include="LGAC.Core" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\lg-ac.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\windows\src\LGAC.Core\LGAC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LGAC.Linux.Tests" />
  </ItemGroup>

</Project>
