<UserControl x:Class="LGAC.App.Views.LoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="SwitchDeviceButton"
                Width="26"
                Height="26"
                Margin="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                AutomationProperties.Name="Trocar aparelho"
                Click="OnSwitchDeviceClick"
                Content="&#xE76B;"
                FontSize="11"
                Style="{StaticResource CircleButton}"
                ToolTip="Trocar aparelho"
                Visibility="Collapsed" />
        <StackPanel Margin="20">
            <Path x:Name="Spinner"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  Data="M 10,2 A 8,8 0 1 1 2,10"
                  RenderTransformOrigin="0.5,0.5"
                  Stroke="{DynamicResource SecondaryForegroundBrush}"
                  StrokeEndLineCap="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="2" />
            <StackPanel x:Name="MessagePanel" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MessageText"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="RetryButton"
                            VerticalAlignment="Center"
                            Click="OnRetryClick"
                            Content="Tentar de novo"
                            Style="{StaticResource StandardButton}" />
                    <Button x:Name="SettingsButton"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Configurações"
                            Click="OnSettingsClick"
                            Content="&#xE713;"
                            Style="{StaticResource IconButton}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
